{
  "name": "ossapp",
  "private": true,
  "version": "0.1.0",
  "description": "Plataforma multi-tenant para la gestion de escuelas de artes marciales",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --build --force && npm run typecheck --workspace @ossapp/staff && npm run typecheck --workspace @ossapp/familias",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "psql \"${SUPABASE_DB_URL:-postgresql://postgres:postgres@127.0.0.1:54322/postgres}\" -v ON_ERROR_STOP=1 -f supabase/tests/aislamiento.sql",
    "db:types": "supabase gen types typescript --local --schema public > packages/data/src/types/database.ts",
    "staff": "npm run start --workspace @ossapp/staff",
    "familias": "npm run start --workspace @ossapp/familias",
    "telefono:staff": "./scripts/telefono.sh staff",
    "telefono:familias": "./scripts/telefono.sh familias"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "supabase": "^2.2.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "overrides": {
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-dom": "19.2.3"
  }
}
