# Copia este archivo a .env en la raiz y en cada app (apps/staff/.env, apps/familias/.env).
#
# Valores por defecto del stack LOCAL de Supabase (`npm run db:start` los imprime).
# La anon key local es publica y fija para todos los proyectos locales de Supabase.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Al probar en un dispositivo fisico, sustituye 127.0.0.1 por la IP LAN de esta maquina:
# EXPO_PUBLIC_SUPABASE_URL=http://192.168.1.X:54321

# --- Produccion / nube ---
# 1. npx supabase login
# 2. npx supabase link --project-ref <ref-del-proyecto>
# 3. npx supabase db push
# 4. Sustituye las dos variables de arriba por la URL y la anon key del proyecto cloud.
# NUNCA pongas la service_role key en un archivo EXPO_PUBLIC_*: viaja dentro del bundle de la app.
